# Optional. When set, the Ask assistant uses Claude (with tool calls into the
# deterministic financial engine) to phrase answers. Without it, the built-in
# rule-based assistant answers using the same engine.
ANTHROPIC_API_KEY=

# Optional. Enables email sign-in and cloud sync via Supabase (see README).
# Without these, the app is local-only: data stays in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
