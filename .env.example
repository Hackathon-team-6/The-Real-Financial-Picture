# Copy to .env.local for personal/secret settings. .env.local is never committed.
# Shared, public config (the Supabase project) already lives in the committed .env.

# Optional. When set, the Ask assistant uses Claude (with tool calls into the
# deterministic financial engine) to phrase answers. Without it, the built-in
# rule-based assistant answers using the same engine.
ANTHROPIC_API_KEY=

# Required for the Monthly Report's AI insights and chat (server-side only; never prefix with NEXT_PUBLIC_).
# Without a key, insights fall back to template text and the report chat is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Point at your own Supabase project instead of the shared one in .env.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for the static-OTP login popup (server-only; never prefix with NEXT_PUBLIC_, never put in .env).
# Must be the secret/service_role key of the same project as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
# Static login code accepted for every email (no email is sent). Anyone who knows it can sign in as any email.
AUTH_STATIC_OTP=123456
